# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Live Security & Auth Configuration
JWT_SECRET="replace-with-256-bit-random-secret-in-production"
OTP_PEPPER="replace-with-otp-hmac-pepper"
ALLOW_DEV_OTP_HINT="true"

# Fixed Admin & 24-Hour Scheduled Report Recipient
FIXED_ADMIN_EMAIL="kishore.sathayush@gmail.com"
FIXED_ADMIN_PASSWORD="replace-with-admin-password"
DAILY_REPORT_RECIPIENT_EMAIL="kishore.sathayush@gmail.com"

# MySQL 8 RDS / Database Configuration (Dedicated Secure QR Database)
DB_ENGINE="django.db.backends.mysql"
DB_NAME="secure_qr_verification"
DB_USER="replace-with-db-user"
DB_PASSWORD="replace-with-db-password"
DB_HOST="replace-with-rds-endpoint"
DB_PORT="3306"

# SMS Gateway Configuration
SMS_GATEWAY_URL="http://api.bulksmsgateway.in/sendmessage.php"
SMS_USER="replace-with-sms-user"
SMS_PASSWORD="replace-with-sms-password"
SMS_SENDER="STYUSH"
SMS_TYPE="3"
SMS_TEMPLATE_ID="replace-with-sms-template-id"
RE_SMS_TEMPLATE_ID="replace-with-resend-sms-template-id"

# SMTP Email Configuration
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_HOST_USER="replace-with-smtp-email"
EMAIL_HOST_PASSWORD="replace-with-smtp-app-password"
DEFAULT_FROM_EMAIL="replace-with-from-email"

# AWS S3 Media Storage Configuration
FILE_PATH="https://sathayushstorage.s3.ap-south-1.amazonaws.com/sathayush/"
AWS_ACCESS_KEY_ID="replace-with-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-aws-secret-access-key"
AWS_S3_REGION_NAME="ap-south-1"
AWS_STORAGE_BUCKET_NAME="sathayushstorage"

# Django Deployment Variables
DJANGO_SECRET_KEY="replace-with-django-secret-key"
DJANGO_DEBUG="False"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
REDIS_URL="redis://127.0.0.1:6379/0"
